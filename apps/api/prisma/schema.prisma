// POD database schema (see docs/00-MASTER-PLAN.md §5). Money = integer cents + ISO currency.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Key/value store settings (markup rules, DPI thresholds, shop open/closed …)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ── Identity ──

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  role            Role      @default(CUSTOMER)
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions  Session[]
  addresses Address[]
  designs   Design[]
  assets    Asset[]
  orders    Order[]
  reviews   Review[]
  carts     Cart[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  phone      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String   @map("postal_code")
  country    String   @db.Char(2)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("addresses")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  target    String?
  ip        String?
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("audit_logs")
}

// ── Catalog (mirrors Printify blueprints chosen by the admin) ──

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  slug     String    @unique
  name     String
  sort     Int       @default(0)
  products Product[]

  @@map("categories")
}

model Product {
  id                  String        @id @default(uuid()) @db.Uuid
  slug                String        @unique
  title               String
  description         String
  status              ProductStatus @default(DRAFT)
  categoryId          String?       @map("category_id") @db.Uuid
  category            Category?     @relation(fields: [categoryId], references: [id])
  printifyBlueprintId Int           @map("printify_blueprint_id")
  printifyProviderId  Int           @map("printify_provider_id")
  brand               String?
  model               String?
  images              Json          @default("[]") /// catalog image URLs from Printify
  currency            String        @default("USD") @db.Char(3)
  markupPercent       Int           @default(60) @map("markup_percent")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  variants   ProductVariant[]
  printAreas PrintArea[]
  designs    Design[]
  reviews    Review[]

  @@unique([printifyBlueprintId, printifyProviderId])
  @@map("products")
}

model ProductVariant {
  id                String  @id @default(uuid()) @db.Uuid
  productId         String  @map("product_id") @db.Uuid
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  printifyVariantId Int     @map("printify_variant_id")
  title             String
  options           Json    @default("{}") /// e.g. {"color":"Black","size":"L"}
  costCents         Int     @map("cost_cents") /// what Printify charges us (admin-entered)
  priceCents        Int     @map("price_cents")
  isEnabled         Boolean @default(true) @map("is_enabled")

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, printifyVariantId])
  @@map("product_variants")
}

/// One printable surface (front, back, sleeve…) with its exact pixel size from Printify placeholders.
model PrintArea {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   String
  widthPx    Int     @map("width_px")
  heightPx   Int     @map("height_px")
  /// Printify variant ids this size applies to (placeholders can differ by variant)
  variantIds Json    @default("[]") @map("variant_ids")

  @@unique([productId, position, widthPx, heightPx])
  @@map("print_areas")
}

// ── Designs & assets ──

enum AssetSource {
  UPLOAD
  AI
  ADMIN
  RENDER
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Asset {
  id         String           @id @default(uuid()) @db.Uuid
  ownerId    String?          @map("owner_id") @db.Uuid
  owner      User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  guestToken String?          @map("guest_token")
  storageKey String           @unique @map("storage_key")
  mime       String
  widthPx    Int              @map("width_px")
  heightPx   Int              @map("height_px")
  bytes      Int
  sha256     String
  source     AssetSource      @default(UPLOAD)
  moderation ModerationStatus @default(APPROVED)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([ownerId])
  @@map("assets")
}

model Design {
  id         String          @id @default(uuid()) @db.Uuid
  ownerId    String?         @map("owner_id") @db.Uuid
  owner      User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  guestToken String?         @map("guest_token") /// sha256 of the guest cookie token
  productId  String          @map("product_id") @db.Uuid
  product    Product         @relation(fields: [productId], references: [id])
  name       String          @default("My design")
  isTemplate Boolean         @default(false) @map("is_template") /// ready-made designs by the shop
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  versions   DesignVersion[]

  @@index([ownerId])
  @@index([guestToken])
  @@map("designs")
}

/// Immutable snapshot. Orders point at the exact version that was bought.
model DesignVersion {
  id         String   @id @default(uuid()) @db.Uuid
  designId   String   @map("design_id") @db.Uuid
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  number     Int
  /// { [position]: { canvas: <editor json>, widthPx, heightPx } }
  areas      Json
  previewKey String?  @map("preview_key")
  /// { [position]: { key, widthPx, heightPx } } — print-ready PNGs at full size
  printFiles Json?    @map("print_files")
  createdAt  DateTime @default(now()) @map("created_at")

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([designId, number])
  @@map("design_versions")
}

// ── Commerce ──

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @unique @map("user_id") @db.Uuid
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique @map("guest_token")
  couponCode String?    @map("coupon_code")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id              String         @id @default(uuid()) @db.Uuid
  cartId          String         @map("cart_id") @db.Uuid
  cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId       String         @map("variant_id") @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  designVersionId String         @map("design_version_id") @db.Uuid
  designVersion   DesignVersion  @relation(fields: [designVersionId], references: [id])
  quantity        Int

  @@map("cart_items")
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id             String     @id @default(uuid()) @db.Uuid
  code           String     @unique
  type           CouponType
  value          Int /// percent (1-100) or cents
  minSubtotal    Int        @default(0) @map("min_subtotal_cents")
  maxRedemptions Int?       @map("max_redemptions")
  redeemed       Int        @default(0)
  startsAt       DateTime?  @map("starts_at")
  endsAt         DateTime?  @map("ends_at")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("coupons")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SUBMITTING
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELED
  NEEDS_ATTENTION
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  number          String      @unique
  userId          String?     @map("user_id") @db.Uuid
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  status          OrderStatus @default(PENDING_PAYMENT)
  currency        String      @db.Char(3)
  subtotalCents   Int         @map("subtotal_cents")
  discountCents   Int         @default(0) @map("discount_cents")
  shippingCents   Int         @map("shipping_cents")
  totalCents      Int         @map("total_cents")
  couponCode      String?     @map("coupon_code")
  shippingAddress Json        @map("shipping_address")
  shippingMethod  Int         @default(1) @map("shipping_method")
  printifyOrderId String?     @unique @map("printify_order_id")
  lastError       String?     @map("last_error")
  paidAt          DateTime?   @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @map("order_id") @db.Uuid
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId         String         @map("variant_id") @db.Uuid
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  designVersionId   String         @map("design_version_id") @db.Uuid
  designVersion     DesignVersion  @relation(fields: [designVersionId], references: [id])
  quantity          Int
  unitPriceCents    Int            @map("unit_price_cents")
  printifyProductId String?        @map("printify_product_id")

  @@map("order_items")
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String
  providerTxnId String?       @unique @map("provider_txn_id")
  amountCents   Int           @map("amount_cents")
  currency      String        @db.Char(3)
  status        PaymentStatus @default(INITIATED)
  detail        Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payments")
}

model Shipment {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String?
  trackingNumber String?   @map("tracking_number")
  trackingUrl    String?   @map("tracking_url")
  shippedAt      DateTime? @map("shipped_at")
  deliveredAt    DateTime? @map("delivered_at")

  @@unique([orderId, trackingNumber])
  @@map("shipments")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  source      String
  eventId     String    @map("event_id")
  topic       String
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([source, eventId])
  @@map("webhook_events")
}

// ── Content ──

model Review {
  id        String           @id @default(uuid()) @db.Uuid
  productId String           @map("product_id") @db.Uuid
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([productId, userId])
  @@map("reviews")
}
